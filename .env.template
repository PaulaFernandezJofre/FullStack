# DevStack Environment Variables Template
# Copia este archivo a .env y completa tus valores

# =============================================================================
# DJANGO - SEGURIDAD CRÍTICA
# =============================================================================

DJANGO_SECRET_KEY=TU_SECRET_KEY_AQUI_MINIMO_64_CARACTERES
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# SEGURIDAD ADICIONAL (activar en producción)
# =============================================================================

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================

DB_NAME=devstack_db
DB_USER=postgres
DB_PASSWORD=tu_password_db
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# MERCADO PAGO - Payment Gateway
# =============================================================================

MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
MERCADO_PAGO_CLIENT_ID=xxxxx
MERCADO_PAGO_CLIENT_SECRET=xxxxx
MERCADO_PAGO_WEBHOOK_SECRET=xxxxx
MERCADO_PAGO_ENVIRONMENT=sandbox

# IVA Chile (19%) - Habilitar si vendes a Chile
MERCADO_PAGO_CHILE_IVA=False
MERCADO_PAGO_CHILE_IVA_RATE=19

# =============================================================================
# CLOUDINARY - Almacenamiento Gratuito
# =============================================================================

USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# REDIS - Cache (Opcional)
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EMAIL - Configuración SMTP
# =============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=DevStack <noreply@devstack.com>

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

SITE_URL=http://localhost:8000
SUPPORT_EMAIL=soporte@devstack.com
CONTACT_EMAIL=contacto@devstack.com

# =============================================================================
# CELERY - Tareas Asíncronas
# =============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# COMISIONES Y PAGOS
# =============================================================================

PLATFORM_COMMISSION_RATE=0.15
SELLER_COMMISSION_RATE=0.85
MIN_WITHDRAWAL_AMOUNT=50
