# =============================================================================
# LogicPerfect - Environment Variables Example
# =============================================================================
# Copia este archivo como .env y llena con tus valores reales
# NUNCA hagas commit de .env con valores reales
# =============================================================================

# =============================================================================
# DJANGO - SEGURIDAD CRÍTICA
# =============================================================================

DJANGO_SECRET_KEY=TU_SECRET_KEY_DE_64_CARACTERES_MINIMO
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com

# =============================================================================
# DATABASE - PostgreSQL (usar Neon, Railway, o tu proveedor)
# =============================================================================

DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# =============================================================================
# MERCADO PAGO - Obtén tus credenciales en https://mercadopago.com/developers
# =============================================================================

MERCADO_PAGO_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_AQUI
MERCADO_PAGO_ENVIRONMENT=production

# IVA Chile (19%) - Habilitar si vendes a Chile
MERCADO_PAGO_CHILE_IVA=False
MERCADO_PAGO_CHILE_IVA_RATE=19

# =============================================================================
# EMAIL - Configuración SMTP (Gmail, SendGrid, Mailgun, etc.)
# =============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=TU_APP_PASSWORD
DEFAULT_FROM_EMAIL=LogicPerfect <noreply@tudominio.com>

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

SITE_URL=https://tudominio.com
SUPPORT_EMAIL=soporte@tudominio.com
CONTACT_EMAIL=contacto@tudominio.com

# =============================================================================
# COMISIONES Y PAGOS (NO CAMBIAR - Distribución fija)
# =============================================================================

IVA_RATE=0.19
MERCADO_PAGO_FEE_RATE=0.0599
PLATFORM_MAINTENANCE_RATE=0.15
SELLER_RATE=0.64
MIN_WITHDRAWAL_AMOUNT=50
