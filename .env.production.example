# =============================================================================
# LogicPerfect - Production Environment Variables
# =============================================================================
# COPIAR este archivo a .env y completar los valores
# NUNCA hacer commit del archivo .env

# =============================================================================
# DJANGO - SEGURIDAD CRÍTICA
# =============================================================================

# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=TU_SECRET_KEY_AQUI_64_CARACTERES_MINIMO

DEBUG=False

# Tu dominio o subdominio de Render
ALLOWED_HOSTS=logicperfect.onrender.com,localhost,127.0.0.1

# =============================================================================
# SEGURIDAD ADICIONAL
# =============================================================================

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
X_FRAME_OPTIONS=DENY

# =============================================================================
# DATABASE - PostgreSQL (Render proporciona DATABASE_URL)
# =============================================================================

# DATABASE_URL se configura automáticamente en Render
# Formato: postgres://usuario:password@host:puerto/nombre

# =============================================================================
# MERCADO PAGO - Payment Gateway
# =============================================================================

# Obtener credenciales de: https://www.mercadopago.com/developers
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ENVIRONMENT=sandbox

# IVA Chile (19%) - Habilitar si vendes a Chile
MERCADO_PAGO_CHILE_IVA=False
MERCADO_PAGO_CHILE_IVA_RATE=19

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

SITE_URL=https://logicperfect.onrender.com
SUPPORT_EMAIL=soporte@logicperfect.com
CONTACT_EMAIL=contacto@logicperfect.com

# =============================================================================
# EMAIL - SendGrid Free (100 emails/día)
# =============================================================================

# Obtener API key de: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=LogicPerfect <noreply@logicperfect.com>

# =============================================================================
# COMISIONES Y PAGOS
# =============================================================================

PLATFORM_COMMISSION_RATE=0.15
SELLER_COMMISSION_RATE=0.85
MIN_WITHDRAWAL_AMOUNT=50
